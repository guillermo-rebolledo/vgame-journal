{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build", "!.agents"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/**",
        "!src/**/*.stories.*",
        "!src/**/*.test.*",
        "!src/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "storybook",
                      "storybook/**",
                      "@storybook/**",
                      "@fontsource-variable/**",
                      "**/*.stories",
                      "**/*.stories.*",
                      "**/.storybook/**"
                    ],
                    "message": "Storybook is development-only. Import production components directly; keep catalog dependencies in stories and .storybook/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
