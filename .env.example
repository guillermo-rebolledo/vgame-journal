# Neon Postgres (provisioned via Vercel Marketplace; `vercel env pull .env.local`)
DATABASE_URL=

# Better Auth: `openssl rand -base64 32`; URL is the app origin
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (Vercel Marketplace). EMAIL_FROM must be on a verified domain; defaults to Resend's sandbox sender.
RESEND_API_KEY=
EMAIL_FROM=
