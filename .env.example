# Neon Postgres (provisioned via Vercel Marketplace; `vercel env pull .env.local`)
DATABASE_URL=

# Better Auth: `openssl rand -base64 32`; URL is the app origin
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (Vercel Marketplace; both set by the integration). Emails come from noreply@<domain>.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=

# Owner inbox for in-app feedback; unset skips notification emails.
FEEDBACK_EMAIL=

# IGDB, via a Twitch app (https://dev.twitch.tv/console/apps). Server-side only.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Vercel Cron sends it as a bearer token; the release date refresh rejects every request without it. `openssl rand -base64 32`
CRON_SECRET=

# Steam import: server-only key registered at https://steamcommunity.com/dev/apikey.
# Rollout uses the Vercel `steam-import` flag; see docs/verification/issue-151-steam-import.md.
STEAM_WEB_API_KEY=
# Owner-verified country where Steam identifiers are stored; shown in /privacy.
STEAM_STORAGE_COUNTRY=

# Sentry: examples only; complete docs/agents/error-monitoring.md before production setup.
# Vercel flag sentry-monitoring defaults on; changes require a redeploy.
# Local development, previews, tests and Storybook never send Sentry telemetry.
# Public project DSN: Settings > Projects > your project > Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN="https://<public-key>@o<org-id>.ingest.us.sentry.io/<project-id>"
# Exact hostname from the DSN, without its key, protocol or path.
SENTRY_INGEST_HOST="o<org-id>.ingest.us.sentry.io"
SENTRY_ORG=your-organization-slug
SENTRY_PROJECT=shelve-games
# Secret organization token (org:ci); copy privately into .env.local or the Production secret store.
# Never commit a real token or use a NEXT_PUBLIC variable for it.
SENTRY_AUTH_TOKEN=
