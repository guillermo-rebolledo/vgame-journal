{
  "name": "shelve-games",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "SENTRY_ENABLED= NEXT_PUBLIC_SENTRY_ENABLED= NEXT_PUBLIC_SENTRY_DSN= SENTRY_AUTH_TOKEN= next dev",
    "build": "if [ \"$VERCEL_ENV\" = production ]; then drizzle-kit migrate; fi && next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "SENTRY_ENABLED= NEXT_PUBLIC_SENTRY_ENABLED= NEXT_PUBLIC_SENTRY_DSN= SENTRY_AUTH_TOKEN= vitest run --project unit",
    "storybook": "SENTRY_ENABLED= NEXT_PUBLIC_SENTRY_ENABLED= NEXT_PUBLIC_SENTRY_DSN= SENTRY_AUTH_TOKEN= storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "SENTRY_ENABLED= NEXT_PUBLIC_SENTRY_ENABLED= NEXT_PUBLIC_SENTRY_DSN= SENTRY_AUTH_TOKEN= storybook build",
    "test:storybook": "SENTRY_ENABLED= NEXT_PUBLIC_SENTRY_ENABLED= NEXT_PUBLIC_SENTRY_DSN= SENTRY_AUTH_TOKEN= vitest run --project storybook",
    "test:e2e": "SENTRY_ENABLED= NEXT_PUBLIC_SENTRY_ENABLED= NEXT_PUBLIC_SENTRY_DSN= SENTRY_AUTH_TOKEN= playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@flags-sdk/vercel": "^1.6.0",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/nextjs": "11.12.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "flags": "^4.4.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.4.2",
    "@electric-sql/pglite": "^0.5.11",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-mcp": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "storybook": "10.6.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.29.2"
